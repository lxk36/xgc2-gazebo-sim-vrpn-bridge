<?xml version="1.0"?>
<package format="2">
  <name>gazebo_sim_vrpn_bridge</name>
  <version>0.1.0</version>
  <description>In-process and legacy Gazebo Classic pose to VRPN tracker server backends.</description>

  <maintainer email="lxk@example.com">lxk</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>gazebo_dev</build_depend>
  <build_export_depend>gazebo_dev</build_export_depend>
  <depend>gazebo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>roscpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>vrpn</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <build_depend>libxgc2-math-dev</build_depend>
  <build_export_depend>libxgc2-math-dev</build_export_depend>
  <exec_depend>libxgc2-math-dev</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>rosunit</test_depend>
  <test_depend>rospy</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>python3-nose</test_depend>
  <test_depend>vrpn_client_ros</test_depend>

  <export>
    <gazebo_ros plugin_path="${prefix}/lib" />
  </export>
</package>
